# ── Database (Postgres) ───────────────────────────────────────────────────────
# Railway: add a Postgres plugin and reference its connection string here.
DATABASE_URL=
# Optional alias checked first (used by Vercel Postgres / Prisma); leave blank if unused.
DATABASE_POSTGRES_PRISMA_URL=

# ── Auth (NextAuth) ───────────────────────────────────────────────────────────
# Public URL of the deployed app, e.g. https://your-app.up.railway.app
NEXTAUTH_URL=
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI / external APIs ────────────────────────────────────────────────────────
OPENAI_API_KEY=
RAPIDAPI_KEY=
REPLICATE_API_TOKEN=

# Model overrides for the Next.js API routes (defaults shown in src/lib/models.ts).
# Default to the gpt-5.5 flagship; dial back per-task to trade quality for cost.
# OPENAI_VISION_MODEL=gpt-5.5
# OPENAI_COPY_MODEL=gpt-5.5
# OPENAI_CLASSIFY_MODEL=gpt-5.5
# Reasoning effort for quality-critical calls: none|low|medium|high|xhigh.
# Default "high" (quality-first). Bump to "xhigh" to spend even more.
# OPENAI_REASONING_EFFORT=high

# ── Agent service (FastAPI + LangGraph) ───────────────────────────────────────
# Base URL of the Python agent service that runs the RAG + multi-agent graph.
# Local: http://localhost:8000 · Railway: the internal service URL.
AGENT_SERVICE_URL=http://localhost:8000

# ── Puppeteer ─────────────────────────────────────────────────────────────────
# Set automatically inside the Docker image; only override for local runs.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ── Railway MCP ───────────────────────────────────────────────────────────────
# The Railway MCP server (.mcp.json) runs via the Railway CLI: install it
# (npm i -g @railway/cli) and run `railway login`. For headless/CI auth set an
# account token instead: https://docs.railway.com/guides/cli#authenticating-with-a-token
# RAILWAY_API_TOKEN=
