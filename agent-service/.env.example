# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# Model overrides (defaults shown). Update as OpenAI ships newer snapshots.
AGENT_TEXT_MODEL=gpt-5.5
AGENT_VISION_MODEL=gpt-5.5
AGENT_IMAGE_MODEL=gpt-image-2
AGENT_IMAGE_SIZE=1024x1536
AGENT_IMAGE_QUALITY=high
# GPT-5 family reasoning effort: none|low|medium|high|xhigh (quality-first default).
AGENT_REASONING_EFFORT=high
AGENT_EMBED_MODEL=text-embedding-3-large
# Optional OpenAI-compatible base URL for ALL calls (gateway / proxy). Empty = OpenAI.
# OPENAI_BASE_URL=

# ── Reference analysis (read Korean text + describe layout) ───────────────────
# Perception task (OCR + layout) → an open VLM is fully competitive here.
# Leave unset to reuse the main vision model (gpt-5.5), or flip to Qwen3-VL via
# an OpenAI-compatible provider (no GPU on your side — Railway stays CPU).
# Qwen3-VL supersedes 2.5-VL: 32-language OCR (incl. Korean) + text bounding
# boxes + document parsing — ideal for read-text-and-describe-layout:
#   AGENT_ANALYZE_MODEL=Qwen/Qwen3-VL-8B-Instruct      # or Qwen3-VL-30B-A3B-Instruct
#   AGENT_ANALYZE_BASE_URL=https://api.together.xyz/v1   # or https://openrouter.ai/api/v1
#   AGENT_ANALYZE_API_KEY=...                            # provider key
# AGENT_ANALYZE_MODEL=
# AGENT_ANALYZE_BASE_URL=
# AGENT_ANALYZE_API_KEY=

# ── RAG ───────────────────────────────────────────────────────────────────────
# Shared with the Next.js app; enables pgvector persistence when present.
DATABASE_URL=
# Defaults to ../src/templates relative to the app package.
# AGENT_TEMPLATES_DIR=
AGENT_RAG_TOP_K=4

# ── Agent loop ────────────────────────────────────────────────────────────────
AGENT_QUALITY_THRESHOLD=8.0
AGENT_MAX_REVISIONS=2
